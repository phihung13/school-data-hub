# Mẫu biến môi trường PRODUCTION — chép thành apps/hub/.env.local trên VPS rồi điền thật.
# LUẬT: file thật không bao giờ vào git; mọi chuỗi bí mật sinh bằng `openssl rand -base64 48`;
# production THIẾU secret nào là server TỪ CHỐI LÊN (secrets.ts) — đó là tính năng.

# ── Lõi ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HUB_URL=https://hub.truongvietanh.com
# Gọi nội bộ trong cùng máy (logout back-channel) — loopback, KHÔNG phải tên miền:
HUB_INTERNAL_URL=http://127.0.0.1:3000

# ── Database: SUPABASE qua Supavisor transaction pooling (05-capacity-ops.md) ─
# Lấy trong Supabase dashboard → Connect → Transaction pooler (cổng 6543).
DATABASE_URL=postgres://postgres.<ref>:<mat-khau>@<vung>.pooler.supabase.com:6543/postgres
PGPOOL_MAX=10

# ── Phiên + OIDC (mỗi chuỗi MỘT việc — xem secrets.ts) ──────────────────────
AUTH_SESSION_SECRET=<openssl rand -base64 48>
INTERNAL_RPC_SECRET=<openssl rand -base64 48>
OIDC_COOKIE_KEYS=<openssl rand -base64 48>
# Khoá ký OIDC: sinh MỘT lần bằng `node tools/oidc-sinh-khoa.mjs` nếu có, hoặc giữ
# nguyên JWKS đang dùng ở máy cũ để app ngoài không phải đổi (kid giữ nguyên):
OIDC_JWKS=<JSON JWKS — chép từ máy đang chạy nếu muốn giữ khoá cũ>

# ── Chuỗi chung cho mini app (NỢ #65: VPS là hạn chót đổi khỏi vietanh2026) ──
EMBED_WEBHOOK_SECRET_CHUNG=<openssl rand -base64 48 — gửi riêng từng đội app>
# Cửa sổ chồng lấn khi xoay (RP đổi dần trong 1 tuần):
# EMBED_WEBHOOK_SECRET_CHUNG_PREVIOUS=vietanh2026
# EMBED_WEBHOOK_SECRET_CHUNG_PREVIOUS_UNTIL=2026-09-08

# ── SSO Google thật (qua Supabase Auth) ─────────────────────────────────────
# Đặt biến này là nút "Đăng nhập với Google" chuyển từ cửa dev sang SSO thật.
SUPABASE_URL=https://<ref>.supabase.co

# ── AI (đường pii-stripper) ─────────────────────────────────────────────────
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# ── TUYỆT ĐỐI KHÔNG ĐẶT TRÊN VPS (đóng nợ #19/#63) ─────────────────────────
# DEV_LOGIN_CHO_PHEP_O_BAN_THAT  ← thiếu biến này, cửa đăng nhập thử KHÔNG TỒN TẠI (404)
# HUB_TRINH_DIEN                 ← chế độ trình diễn là đồ của máy dev
