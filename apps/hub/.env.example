DATABASE_URL=postgres://postgres:postgres@localhost:5432/hub_dev
AUTH_SESSION_SECRET=change-me-to-a-random-32-plus-character-string
# Địa chỉ công khai Hub (issuer OIDC). Dev thuần local để trống được; khi có RP ngoài đi qua
# tunnel/proxy thì BẮT BUỘC set đúng origin công khai, nếu không RP báo "issuer mismatch".
HUB_URL=https://hub.truongvietanh.com
# Secret của RP Factory. Không set thì client_id=factory không tồn tại (/oidc/auth trả invalid_client).
OIDC_CLIENT_SECRET_FACTORY=
# Xoay khóa không làm gãy RP (09-hop-dong-app-ngoai.md §1b): trong thời hạn dưới đây Hub nhận
# CẢ khóa cũ lẫn khóa mới, RP đổi lúc nào cũng được. Bỏ trống khi không xoay. Có _PREVIOUS mà
# thiếu _PREVIOUS_UNTIL thì cửa sổ KHÔNG bật (server báo lỗi lúc khởi động) — cố ý fail closed.
OIDC_CLIENT_SECRET_FACTORY_PREVIOUS=
OIDC_CLIENT_SECRET_FACTORY_PREVIOUS_UNTIL=
